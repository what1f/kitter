    "pane": {
      "border": "edge",
      "shadows": [
        "inset 0 1 0 0 rim",
        "inset 0 0 0 1 inner",
        "0 1 2 0 contact",
        "0 12 32 -14 shade"
      ]
    },
    "popover": {
      "border": "popover_edge",
      "shadows": [
        "inset 0 1 0 0 rim",
        "inset 0 -1 0 0 popover_under",
        "0 24 60 -18 shade",
        "0 6 16 -6 lift"
      ]
