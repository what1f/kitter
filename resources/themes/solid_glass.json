        "0 1 2 0 contact"
      ]
    },
    "state": {
      "fill": "state",
      "shadows": [
        "inset 0 1 0 0 state_rim",
        "inset 0 0 0 1 state_edge"
      ]
    },
    "primary": {
      "border": "primary_edge",
      "shadows": [
        "inset 0 1 0 0 primary_rim",
