---
import { Picture } from 'astro:assets';
import art from '../assets/art/drift.png';
import { dicts, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang].drift;

---
<section class="section drift">
  <div class="wrap">
    <div class="head">
      <h2 class="title" data-reveal>{t.title.map((l, i) => <>{i > 0 && (lang === 'zh' ? '\u200b' : ' ')}<span>{l}</span></>)}</h2>
      <p class="lede" data-reveal style="--delay: 80ms">{t.lede}</p>
    </div>
    <div class="scene" data-reveal style="--delay: 120ms">
      <Picture formats={['avif', 'webp']} class="art" src={art} alt="" widths={[800, 1200, 1672]} sizes="(max-width: 1240px) 100vw, 1200px" />
    </div>
  </div>
</section>

<style>
  .scene {
    position: relative;
    max-width: 1100px;
    margin: clamp(40px, 6vw, 72px) auto 0;
    aspect-ratio: 1672 / 941;
  }

  .scene :global(.art) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .scene :global(.art) {
    filter: drop-shadow(0 30px 36px var(--art-shadow));
  }

</style>
